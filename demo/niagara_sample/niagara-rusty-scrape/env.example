# Copy to .env and source before running: cp env.example .env && source .env
#
# Example lab (Open-FDD bench, 2026-06):
#   JACE_HOST=192.168.204.11
#   HAYSTACK_USER=open_fdd
#   HAYSTACK_BASE=https://192.168.204.11/haystack
#   Niagara 4.15 + nHaystack 3.3, HTTPBasicScheme, self-signed TLS → use --insecure-tls

export JACE_HOST="<jace-host>"
export HAYSTACK_USER="<haystack-user>"
export HAYSTACK_PASS="replace-me"
export HAYSTACK_BASE="https://${JACE_HOST}/haystack"

# Optional overrides for niagara-read:
# export HAYSTACK_AUTH=basic    # basic (Niagara) | scram (SkySpark / rusty-haystack server)
# export HAYSTACK_TLS_VERIFY=true
# cargo run -- --insecure-tls   # self-signed lab cert only
