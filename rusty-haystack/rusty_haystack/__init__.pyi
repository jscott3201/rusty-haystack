__version__: str
_T = TypeVar("_T")
_Value: TypeAlias = "None | bool | str | Marker | NA | Remove | Number | Ref | Uri | Symbol | XStr | Coord | date | time | HDateTime | Int | Float | NoneValue | Buf | Nominal | HDict | HList | HGrid"
_InputValue: TypeAlias = "_Value | int | float"
_V = TypeVar("_V", bound=_InputValue)

class Int:
    """Signed i64 identity, distinct from Number and Float; equality only."""
    def __init__(self, value: int) -> None: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

class Float:
    """Exact binary64 representation identity; equality only."""
    def __init__(self, value: int | float) -> None: ...
    @staticmethod
    def from_bits(bits: int) -> Float: ...
    @property
    def bits(self) -> int: ...
    @property
    def value(self) -> float: ...
    def __float__(self) -> float: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

