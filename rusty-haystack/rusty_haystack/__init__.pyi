class HGrid:
    """Haystack Grid — a two-dimensional table of tagged data.

    The primary data exchange format in the Haystack protocol.

    Examples:
        g = HGrid()
        g = HGrid.from_parts(meta, cols, rows)
        g.add_row(HDict({"dis": "Room 101"}))
    """
    def __init__(self) -> None: ...
    @staticmethod
    def from_parts(meta: HDict, cols: list[HCol], rows: list[HDict]) -> HGrid:
        """Construct a grid from metadata, columns, and rows."""
        ...
    def add_row(self, row: HDict) -> None:
        """Add a row (HDict) to the grid."""
        ...
    def set_meta(self, meta: HDict) -> None:
        """Set the grid metadata."""
        ...
    def add_col(self, name: str, meta: HDict | None = None) -> None:
        """Add a column to the grid."""
        ...
    def rows(self) -> list[HDict]:
        """Return all rows as a list of HDict."""
        ...
    def cols(self) -> list[HCol]:
        """Return all columns as a list of HCol."""
        ...
    def col(self, name: str) -> HCol | None:
        """Look up a column by name."""
        ...
    def col_names(self) -> list[str]:
        """Return column names as a list."""
        ...
    def num_cols(self) -> int:
        """Return the number of columns."""
        ...
    def meta(self) -> HDict:
        """Return the grid metadata."""
        ...
    def is_empty(self) -> bool:
        """Return True if the grid has no rows."""
        ...
    def is_err(self) -> bool:
        """Return True if this is an error grid."""
        ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> HDict: ...
    def __iter__(self) -> Iterator[HDict]: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...


