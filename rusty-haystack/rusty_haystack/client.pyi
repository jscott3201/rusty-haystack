class AsyncHaystackClient:
    """Owned asyncio HTTP client; methods return Future objects.

    The first operation binds the exact running loop and OS thread. Absolute
    deadlines use that loop's clock and can shorten the finite timeout budget.
    Close succeeds only after native runtime/thread and operation guards drain.
    Watch keys reserve one logical owner per session, with at most 32 live or
    unconfirmed reservations. Local Unknown cleanup does not free a key.
    """
    def __init__(
        self,
        url: str,
        username: str,
        password: str,
        *,
        tls: TlsConfig | None = None,
        timeout: float = 30.0,
        tls_verify: bool = True,
        h5: H5Config | None = None,
    ) -> None:
        """Construct an owned async HTTP client (call ``connect`` / ``async with``).

        ``tls_verify`` defaults to ``True``. ``tls_verify=False`` disables
        certificate-chain and hostname verification for lab/dev only; it applies
        to SCRAM and subsequent HTTPS ops, not WebSocket TLS or redirects.
        Optional ``tls`` supplies client identity and/or extra CA trust and is
        retained when combined with ``tls_verify``.
        """
        ...
    @property
    def state(self) -> Literal["new", "connecting", "open", "closing", "closed"]: ...
    @property
    def closed(self) -> bool: ...
    def watch(self, ids: list[str], *, key: str, lease_ms: int = 60_000, cleanup_timeout: float = 2.0) -> AsyncWatch: ...
    def connect(self, *, deadline: float | None = None) -> Future[None]: ...
    def read(self, filter: str, limit: int = 100, *, deadline: float | None = None) -> Future[HGrid]: ...
    def read_by_id(self, id: Ref | None = None, *, checked: bool = True, deadline: float | None = None) -> Future[HDict | None]:
        """H5 lookup; requires h5=H5Config(). Unchecked missing returns None."""
        ...
    def read_by_ids(self, ids: list[Ref], *, checked: bool = True, deadline: float | None = None) -> Future[HGrid]:
        """H5 ordered lookup, retaining duplicates and unchecked empty rows."""
        ...
    def close(self, *, deadline: float | None = None) -> Future[None]: ...
    def __aenter__(self) -> Future[AsyncHaystackClient]: ...
    def __aexit__(self, _exc_type: type[BaseException] | None, exc_value: BaseException | None, _traceback: TracebackType | None) -> Future[None]: ...


class WatchDelivery:
    """Immutable native snapshot; changed rows are fresh, mutable owned copies."""
    @property
    def authority(self) -> str: ...
    @property
    def watch_id(self) -> str: ...
    @property
    def key(self) -> str: ...
    @property
    def dataset(self) -> str: ...
    @property
    def incarnation(self) -> str: ...
    @property
    def catalog_generation(self) -> int: ...
    @property
    def scope_generation(self) -> int: ...
    @property
    def token(self) -> str: ...
    @property
    def from_revision(self) -> int: ...
    @property
    def through(self) -> int: ...
    @property
    def initial(self) -> bool: ...
    @property
    def changed(self) -> tuple[HDict, ...]: ...
    @property
    def removed(self) -> tuple[str, ...]: ...

class WatchControl:
    @property
    def kind(self) -> str: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def watch_id(self) -> str | None: ...
    @property
    def key(self) -> str | None: ...
    @property
    def token(self) -> str | None: ...
    @property
    def through(self) -> int | None: ...
    @property
    def scope_generation(self) -> int | None: ...
    @property
    def local_joined(self) -> bool: ...

class AsyncWatch:
    """One pending delivery, explicit ACK/renew/resume and owned finite cleanup.

    Future completion is not consumer acknowledgement. Use async with or aclose
    for early exit; ordinary async-for break does not close a custom iterator.
    The parent's key reservation survives locally joined unconfirmed cleanup.
    """
    @property
    def key(self) -> str: ...
    @property
    def state(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    @property
    def pending(self) -> WatchDelivery | None: ...
    def ready(self, *, deadline: float | None = None) -> Future[WatchControl]: ...
    def __aiter__(self) -> AsyncWatch: ...
    def __anext__(self) -> Future[WatchDelivery | WatchControl]: ...
    def next(self, *, deadline: float | None = None) -> Future[WatchDelivery | WatchControl]: ...
    def ack(self, delivery: WatchDelivery, *, deadline: float | None = None) -> Future[WatchControl]: ...
    def resume(self, *, deadline: float | None = None) -> Future[WatchDelivery | WatchControl]: ...
    def renew(self, lease_ms: int, *, deadline: float | None = None) -> Future[WatchControl]: ...
    def aclose(self, *, deadline: float | None = None) -> Future[WatchControl]: ...
    def __aenter__(self) -> Coroutine[Any, Any, AsyncWatch]: ...
    def __aexit__(self, _exc_type: type[BaseException] | None, exc_value: BaseException | None, _traceback: TracebackType | None) -> Future[None]: ...
